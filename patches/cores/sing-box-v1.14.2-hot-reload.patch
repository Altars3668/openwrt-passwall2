+func (r *reloadTestRouter) RouteConnectionEx(ctx context.Context, conn net.Conn, metadata adapter.InboundContext, onClose N.CloseHandlerFunc) {
+	r.closed = onClose
+}
+
+func TestHotReloadConnectionLease(t *testing.T) {
+	delegate := &reloadTestRouter{}
+	r := newConfigReloader(context.Background(), option.Options{}, delegate)
+	bridge := &reloadRouter{Router: delegate, reload: r}
+	bridge.RouteConnectionEx(context.Background(), nil, adapter.InboundContext{}, nil)
+	if r.current.active != 1 {
+		t.Fatal("连接建立后缺少运行实例引用")
+	}
+	delegate.closed(nil)
+	delegate.closed(nil)
+	if r.current.active != 0 {
+		t.Fatal("结束回调没有恰好释放一次引用")
+	}
+}
+
+func TestHotReloadLeaseConcurrent(t *testing.T) {
+	r := newConfigReloader(context.Background(), option.Options{}, &reloadTestRouter{})
+	var group sync.WaitGroup
+	for i := 0; i < 100; i++ {
+		group.Add(1)
+		go func() { defer group.Done(); _, release := r.acquire(); release(); release() }()
+	}
+	group.Wait()
+	if r.current.active != 0 {
+		t.Fatal("并发引用没有排空")
+	}
+}
+
+func TestHotReloadUnsupportedResources(t *testing.T) {
+	for _, options := range []option.Options{
+		{Inbounds: []option.Inbound{{Type: "tun"}}},
+		{Endpoints: []option.Endpoint{{Type: "wireguard"}}},
+		{Outbounds: []option.Outbound{{Type: "loopback"}}},
+	} {
+		if reloadSupported(options) {
+			t.Fatal("独占资源不能进入热重载")
+		}
+	}
+}
+
+func TestHotReloadInboundChanges(t *testing.T) {
+	socks := func(tag string, port uint16) option.Inbound {
+		return option.Inbound{Type: "socks", Tag: tag, Options: &option.SocksInboundOptions{ListenOptions: option.ListenOptions{ListenPort: port}}}
+	}
+	previous := []option.Inbound{socks("a", 1), socks("b", 2), socks("c", 3)}
+	next := []option.Inbound{socks("b", 2), socks("a", 4), socks("d", 5)}
+	changes, ok := inboundChanges(previous, next)
+	if !ok || len(changes) != 3 {
+		t.Fatalf("入站差异计算错误：%v %d", ok, len(changes))
+	}
+	kinds := map[string]string{}
+	for _, change := range changes {
+		switch {
+		case change.previous != nil && change.next != nil:
+			kinds[change.tag] = "changed"
+		case change.next != nil:
+			kinds[change.tag] = "added"
+		default:
+			kinds[change.tag] = "removed"
+		}
+	}
+	if kinds["a"] != "changed" || kinds["d"] != "added" || kinds["c"] != "removed" || kinds["b"] != "" {
+		t.Fatalf("入站差异分类错误：%v", kinds)
+	}
+	if _, ok := inboundChanges(previous, append(next, socks("", 6))); ok {
+		t.Fatal("没有 tag 的新入站不能热重载")
+	}
+	if _, ok := inboundChanges(previous, []option.Inbound{socks("a", 1), socks("a", 7)}); ok {
+		t.Fatal("tag 重复的入站不能热重载")
+	}
+	if changes, ok := inboundChanges(previous, previous); !ok || len(changes) != 0 {
+		t.Fatal("相同入站不应产生变化")
+	}
+}
