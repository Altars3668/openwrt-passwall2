diff --git a/config_reload.go b/config_reload.go
new file mode 100644
index 0000000..72d1462
--- /dev/null
+++ b/config_reload.go
@@ -0,0 +1,438 @@
+package box
+
+import (
+	"context"
+	"errors"
+	"net"
+	"os"
+	"reflect"
+	"sync"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/trafficcontrol"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	F "github.com/sagernet/sing/common/format"
+	"github.com/sagernet/sing/common/json"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/service"
+)
+
+var ErrHotReloadUnsupported = adapter.ErrHotReloadUnsupported
+
+const maxReloadGenerations = 8
+
+type reloadGeneration struct {
+	box     *Box
+	router  adapter.Router
+	options option.Options
+	cancel  context.CancelFunc
+	active  int
+	retired bool
+}
+
+type configReloader struct {
+	mu          sync.Mutex
+	applyMu     sync.Mutex
+	closeWait   sync.WaitGroup
+	closing     int
+	ctx         context.Context
+	current     *reloadGeneration
+	initial     *reloadGeneration
+	generations []*reloadGeneration
+	closed      bool
+	// 初始实例创建入站时使用的路由（转发到当前运行实例），热重载新建的入站沿用它。
+	inboundRouter adapter.Router
+}
+
+func newConfigReloader(ctx context.Context, options option.Options, router adapter.Router) *configReloader {
+	initial := &reloadGeneration{router: router, options: options}
+	return &configReloader{ctx: ctx, current: initial, initial: initial, generations: []*reloadGeneration{initial}}
+}
+
+func normalizedOptions(options option.Options) option.Options {
+	options.RawMessage, options.CommentsSet = nil, nil
+	return options
+}
+
+func reloadStaticOptions(options option.Options) option.Options {
+	options = normalizedOptions(options)
+	// 入站由初始实例持有，变化的入站在切换时单独关闭重建（见 inboundChanges）。
+	options.Outbounds, options.DNS, options.Inbounds = nil, nil, nil
+	if options.Route != nil {
+		route := *options.Route
+		route.Rules, route.RuleSet, route.Final = nil, nil, ""
+		options.Route = &route
+	}
+	return options
+}
+
+func reloadSupported(options option.Options) bool {
+	if len(options.Endpoints) > 0 || len(options.Services) > 0 || len(options.NetworkNamespaces) > 0 {
+		return false
+	}
+	for _, inbound := range options.Inbounds {
+		if inbound.Type == "tun" {
+			return false
+		}
+	}
+	for _, outbound := range options.Outbounds {
+		if outbound.Type == "wireguard" || outbound.Type == "loopback" || outbound.Type == "tun" {
+			return false
+		}
+	}
+	return true
+}
+
+type inboundChange struct {
+	tag      string
+	previous *option.Inbound
+	next     *option.Inbound
+}
+
+// 按 tag 比较入站：新增、删除与内容变化的入站。没有 tag 的入站由启动顺序决定名字，无法安全对应，返回 false。
+func inboundChanges(previous, next []option.Inbound) ([]inboundChange, bool) {
+	old := make(map[string]option.Inbound, len(previous))
+	for _, inbound := range previous {
+		if inbound.Tag == "" {
+			return nil, reflect.DeepEqual(previous, next)
+		}
+		old[inbound.Tag] = inbound
+	}
+	var changes []inboundChange
+	seen := make(map[string]bool, len(next))
+	for i := range next {
+		inbound := next[i]
+		if inbound.Tag == "" || seen[inbound.Tag] {
+			return nil, false
+		}
+		seen[inbound.Tag] = true
+		if before, loaded := old[inbound.Tag]; !loaded {
+			changes = append(changes, inboundChange{tag: inbound.Tag, next: &next[i]})
+		} else if !reflect.DeepEqual(before, inbound) {
+			changes = append(changes, inboundChange{tag: inbound.Tag, previous: &before, next: &next[i]})
+		}
+	}
+	for i := range previous {
+		if !seen[previous[i].Tag] {
+			changes = append(changes, inboundChange{tag: previous[i].Tag, previous: &previous[i]})
+		}
+	}
+	return changes, true
+}
+
+// 在初始实例的入站管理器上应用入站变化：先关闭旧入站（同端口才能重新绑定），再创建新入站。
+// 新入站经 inboundRouter 交给当前运行实例。任一步失败按相反顺序恢复原入站并返回错误。
+func (r *configReloader) applyInbounds(changes []inboundChange) (func(), error) {
+	initial := r.initial.box
+	if initial == nil || r.inboundRouter == nil {
+		return nil, ErrHotReloadUnsupported
+	}
+	manager := initial.inbound
+	create := func(inbound *option.Inbound) error {
+		logger := initial.logFactory.NewLogger(F.ToString("inbound/", inbound.Type, "[", inbound.Tag, "]"))
+		return manager.Create(r.ctx, r.inboundRouter, logger, inbound.Tag, inbound.Type, inbound.Options)
+	}
+	var undo []func()
+	rollback := func() {
+		for i := len(undo) - 1; i >= 0; i-- {
+			undo[i]()
+		}
+	}
+	// 先关闭全部要删除或替换的旧入站，再创建新入站：换 tag 但沿用端口（如重定向改为 TPROXY）时才能绑定。
+	for _, change := range changes {
+		change := change
+		if change.previous != nil {
+			if err := manager.Remove(change.tag); err != nil && !errors.Is(err, os.ErrInvalid) {
+				rollback()
+				return nil, E.Cause(err, "close inbound ", change.tag)
+			}
+			undo = append(undo, func() { _ = create(change.previous) })
+		}
+	}
+	for _, change := range changes {
+		change := change
+		if change.next != nil {
+			if err := create(change.next); err != nil {
+				rollback()
+				return nil, E.Cause(err, "create inbound ", change.tag)
+			}
+			undo = append(undo, func() { _ = manager.Remove(change.tag) })
+		}
+	}
+	return rollback, nil
+}
+
+func reloadFakeIPOptions(options option.Options) []option.DNSServerOptions {
+	var result []option.DNSServerOptions
+	if options.DNS != nil {
+		for _, server := range options.DNS.Servers {
+			if server.Type == "fakeip" {
+				result = append(result, server)
+			}
+		}
+	}
+	return result
+}
+
+func (r *configReloader) collectLocked(generation *reloadGeneration) {
+	// 初始实例仍拥有监听器、控制 API 和共享日志，不能整体关闭。
+	if !generation.retired || generation.active != 0 || generation.cancel == nil {
+		return
+	}
+	for i, candidate := range r.generations {
+		if candidate == generation {
+			r.generations = append(r.generations[:i], r.generations[i+1:]...)
+			break
+		}
+	}
+	cancel := generation.cancel
+	generation.cancel = nil
+	r.closeWait.Add(1)
+	r.closing++
+	go func() {
+		defer r.closeWait.Done()
+		cancel()
+		generation.box.Close()
+		r.mu.Lock()
+		r.closing--
+		r.mu.Unlock()
+	}()
+}
+
+func (r *configReloader) acquire() (*reloadGeneration, func()) {
+	r.mu.Lock()
+	if r.closed {
+		r.mu.Unlock()
+		return nil, func() {}
+	}
+	generation := r.current
+	generation.active++
+	r.mu.Unlock()
+	var once sync.Once
+	return generation, func() {
+		once.Do(func() {
+			r.mu.Lock()
+			generation.active--
+			r.collectLocked(generation)
+			r.mu.Unlock()
+		})
+	}
+}
+
+func (r *configReloader) ReloadConfig(requestCtx context.Context, content []byte) error {
+	r.applyMu.Lock()
+	defer r.applyMu.Unlock()
+	options, err := json.UnmarshalExtendedContext[option.Options](r.ctx, content)
+	if err != nil {
+		return E.Cause(err, "decode hot reload configuration")
+	}
+	r.mu.Lock()
+	if r.closed {
+		r.mu.Unlock()
+		return net.ErrClosed
+	}
+	previous := r.current
+	if reflect.DeepEqual(normalizedOptions(previous.options), normalizedOptions(options)) {
+		r.mu.Unlock()
+		return nil
+	}
+	changes, comparable := inboundChanges(previous.options.Inbounds, options.Inbounds)
+	if !comparable || !reloadSupported(previous.options) || !reloadSupported(options) ||
+		!reflect.DeepEqual(reloadStaticOptions(previous.options), reloadStaticOptions(options)) ||
+		!reflect.DeepEqual(reloadFakeIPOptions(previous.options), reloadFakeIPOptions(options)) ||
+		len(r.generations)+r.closing >= maxReloadGenerations {
+		r.mu.Unlock()
+		return ErrHotReloadUnsupported
+	}
+	r.mu.Unlock()
+	if err := requestCtx.Err(); err != nil {
+		return err
+	}
+	staged := options
+	staged.HotReload = false
+	staged.Inbounds, staged.Endpoints, staged.Services = nil, nil, nil
+	staged.Experimental, staged.NTP, staged.Certificate, staged.CertificateProviders = nil, nil, nil, nil
+	staged.RawMessage, staged.CommentsSet = nil, nil
+	ctx, cancel := context.WithCancel(service.ExtendContext(r.ctx))
+	if len(reloadFakeIPOptions(options)) > 0 {
+		initial := r.initial.box
+		if initial == nil || initial.dnsTransport.FakeIP() == nil {
+			cancel()
+			return ErrHotReloadUnsupported
+		}
+		service.MustRegister[adapter.FakeIPStore](ctx, adapter.BorrowedFakeIPStore{FakeIPStore: initial.dnsTransport.FakeIP().Store()})
+	}
+	stopCancellation := context.AfterFunc(requestCtx, cancel)
+	defer stopCancellation()
+	instance, err := New(Options{Options: staged, Context: ctx, reuseLogFactory: true})
+	if err != nil {
+		cancel()
+		return E.Cause(err, "prepare hot reload instance")
+	}
+	if tracker := service.PtrFromContext[trafficcontrol.Manager](r.ctx); tracker != nil {
+		instance.router.AppendTracker(tracker)
+	}
+	if err = instance.Start(); err != nil {
+		cancel()
+		return E.Cause(err, "start hot reload instance")
+	}
+	if !stopCancellation() || requestCtx.Err() != nil || ctx.Err() != nil {
+		cancel()
+		instance.Close()
+		return E.New("hot reload request canceled before commit")
+	}
+	// 入站变化在新运行实例就绪之后、切换之前应用；新入站的连接在切换前由当前实例处理，切换后由新实例处理。
+	var undoInbounds func()
+	if len(changes) > 0 {
+		undoInbounds, err = r.applyInbounds(changes)
+		if err != nil {
+			cancel()
+			instance.Close()
+			return E.Cause(err, "apply hot reload inbounds")
+		}
+	}
+	r.mu.Lock()
+	if r.closed {
+		r.mu.Unlock()
+		if undoInbounds != nil {
+			undoInbounds()
+		}
+		cancel()
+		instance.Close()
+		return net.ErrClosed
+	}
+	generation := &reloadGeneration{box: instance, router: instance.router, options: options, cancel: cancel}
+	r.generations = append(r.generations, generation)
+	r.current = generation
+	previous.retired = true
+	r.collectLocked(previous)
+	r.mu.Unlock()
+	return nil
+}
+
+func (r *configReloader) close() {
+	r.applyMu.Lock()
+	defer r.applyMu.Unlock()
+	r.mu.Lock()
+	r.closed = true
+	var targets []struct {
+		cancel context.CancelFunc
+		box    *Box
+	}
+	for _, generation := range r.generations {
+		if generation.cancel != nil {
+			targets = append(targets, struct {
+				cancel context.CancelFunc
+				box    *Box
+			}{generation.cancel, generation.box})
+			generation.cancel = nil
+		}
+	}
+	r.generations = nil
+	r.mu.Unlock()
+	for _, target := range targets {
+		target.cancel()
+		target.box.Close()
+	}
+	r.closeWait.Wait()
+}
+
+type reloadRouter struct {
+	adapter.Router
+	reload *configReloader
+}
+
+func (r *reloadRouter) RouteConnection(ctx context.Context, conn net.Conn, metadata adapter.InboundContext) error {
+	generation, release := r.reload.acquire()
+	defer release()
+	if generation == nil {
+		conn.Close()
+		return net.ErrClosed
+	}
+	return generation.router.RouteConnection(ctx, conn, metadata)
+}
+
+func (r *reloadRouter) RoutePacketConnection(ctx context.Context, conn N.PacketConn, metadata adapter.InboundContext) error {
+	generation, release := r.reload.acquire()
+	defer release()
+	if generation == nil {
+		conn.Close()
+		return net.ErrClosed
+	}
+	return generation.router.RoutePacketConnection(ctx, conn, metadata)
+}
+
+func (r *reloadRouter) RouteConnectionEx(ctx context.Context, conn net.Conn, metadata adapter.InboundContext, onClose N.CloseHandlerFunc) {
+	generation, release := r.reload.acquire()
+	if generation == nil {
+		N.CloseOnHandshakeFailure(conn, onClose, net.ErrClosed)
+		return
+	}
+	generation.router.RouteConnectionEx(ctx, conn, metadata, N.OnceClose(func(err error) {
+		defer release()
+		if onClose != nil {
+			onClose(err)
+		}
+	}))
+}
+
+func (r *reloadRouter) RoutePacketConnectionEx(ctx context.Context, conn N.PacketConn, metadata adapter.InboundContext, onClose N.CloseHandlerFunc) {
+	generation, release := r.reload.acquire()
+	if generation == nil {
+		N.CloseOnHandshakeFailure(conn, onClose, net.ErrClosed)
+		return
+	}
+	generation.router.RoutePacketConnectionEx(ctx, conn, metadata, N.OnceClose(func(err error) {
+		defer release()
+		if onClose != nil {
+			onClose(err)
+		}
+	}))
+}
+
+func (r *reloadRouter) HijackDNSPacket(ctx context.Context, payload []byte, writer N.PacketWriter, metadata adapter.InboundContext) {
+	generation, release := r.reload.acquire()
+	defer release()
+	if generation != nil {
+		generation.router.HijackDNSPacket(ctx, payload, writer, metadata)
+	}
+}
+
+func (r *reloadRouter) Rules() []adapter.Rule {
+	generation, release := r.reload.acquire()
+	defer release()
+	if generation == nil {
+		return nil
+	}
+	return generation.router.Rules()
+}
+
+func (r *reloadRouter) RuleSet(tag string) (adapter.RuleSet, bool) {
+	generation, release := r.reload.acquire()
+	defer release()
+	if generation == nil {
+		return nil, false
+	}
+	return generation.router.RuleSet(tag)
+}
+
+type reloadOutboundView struct {
+	adapter.OutboundManager
+	reload *configReloader
+}
+
+func (v *reloadOutboundView) current() adapter.OutboundManager {
+	v.reload.mu.Lock()
+	defer v.reload.mu.Unlock()
+	if v.reload.current.box == nil {
+		return v.OutboundManager
+	}
+	return v.reload.current.box.outbound
+}
+
+func (v *reloadOutboundView) Outbounds() []adapter.Outbound { return v.current().Outbounds() }
+func (v *reloadOutboundView) Outbound(tag string) (adapter.Outbound, bool) {
+	return v.current().Outbound(tag)
+}
+func (v *reloadOutboundView) Default() adapter.Outbound { return v.current().Default() }
