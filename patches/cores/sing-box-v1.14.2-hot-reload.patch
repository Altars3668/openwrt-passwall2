+
+func hotReloadCapabilities(server *Server) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if service.FromContext[adapter.ConfigReloadManager](server.ctx) == nil {
+			render.Status(r, http.StatusNotImplemented)
+			render.JSON(w, r, render.M{"error": "hot_reload_disabled"})
+			return
+		}
+		render.JSON(w, r, render.M{"hot_reload_version": 1, "preserve_connections": true})
+	}
+}
+
+func hotReloadConfigs(server *Server) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		manager := service.FromContext[adapter.ConfigReloadManager](server.ctx)
+		if manager == nil {
+			render.Status(r, http.StatusNotImplemented)
+			render.JSON(w, r, render.M{"error": "hot_reload_disabled"})
+			return
+		}
+		content, err := io.ReadAll(http.MaxBytesReader(w, r.Body, 8<<20))
+		if err == nil {
+			err = manager.ReloadConfig(r.Context(), content)
+		}
+		if err != nil {
+			status, code := http.StatusBadRequest, "invalid_config"
+			if errors.Is(err, adapter.ErrHotReloadUnsupported) {
+				status, code = http.StatusConflict, "requires_restart"
+			}
+			render.Status(r, status)
+			render.JSON(w, r, render.M{"error": code})
+			return
+		}
+		render.JSON(w, r, render.M{"hot_reload_version": 1, "applied": true})
+	}
+}
