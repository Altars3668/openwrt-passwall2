@@ -0,0 +1,90 @@
+package core
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/xtls/xray-core/common/serial"
+)
+
+func TestHotReloadLeaseHalfClose(t *testing.T) {
+	var released atomic.Int32
+	lease := newLinkLease(context.Background(), func() { released.Add(1) })
+	reader := &leasedReader{lease: lease}
+	writer := &leasedWriter{lease: lease}
+	reader.finish()
+	reader.finish()
+	if released.Load() != 0 {
+		t.Fatal("半关闭错误地释放了运行实例")
+	}
+	writer.finish()
+	writer.finish()
+	if released.Load() != 1 {
+		t.Fatal("双向关闭必须且只能释放一次")
+	}
+}
+
+func TestHotReloadLeaseCancelConcurrent(t *testing.T) {
+	for i := 0; i < 100; i++ {
+		ctx, cancel := context.WithCancel(context.Background())
+		var released atomic.Int32
+		lease := newLinkLease(ctx, func() { released.Add(1) })
+		reader := &leasedReader{lease: lease}
+		writer := &leasedWriter{lease: lease}
+		var group sync.WaitGroup
+		for _, fn := range []func(){cancel, reader.finish, writer.finish} {
+			group.Add(1)
+			go func(fn func()) { defer group.Done(); fn() }(fn)
+		}
+		group.Wait()
+		if released.Load() != 1 {
+			t.Fatal("并发结束必须且只能释放一次")
+		}
+	}
+}
+
+func TestHotReloadCancelBeforeCommit(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	var released atomic.Int32
+	lease := newLinkLease(ctx, func() { released.Add(1) })
+	lease.finish(true)
+	if released.Load() != 1 {
+		t.Fatal("已取消的请求未释放引用")
+	}
+}
+
+func TestHotReloadInboundChanges(t *testing.T) {
+	inbound := func(tag string, port uint32) *InboundHandlerConfig {
+		return &InboundHandlerConfig{Tag: tag, ReceiverSettings: serial.ToTypedMessage(&InboundHandlerConfig{Tag: fmt.Sprint(port)})}
+	}
+	previous := []*InboundHandlerConfig{inbound("a", 1), inbound("b", 2), inbound("c", 3)}
+	next := []*InboundHandlerConfig{inbound("b", 2), inbound("a", 4), inbound("d", 5)}
+	changes, ok := inboundChanges(previous, next)
+	if !ok || len(changes) != 3 {
+		t.Fatalf("入站差异计算错误：%v %d", ok, len(changes))
+	}
+	kinds := map[string]string{}
+	for _, change := range changes {
+		switch {
+		case change.previous != nil && change.next != nil:
+			kinds[change.tag] = "changed"
+		case change.next != nil:
+			kinds[change.tag] = "added"
+		default:
+			kinds[change.tag] = "removed"
+		}
+	}
+	if kinds["a"] != "changed" || kinds["d"] != "added" || kinds["c"] != "removed" || kinds["b"] != "" {
+		t.Fatalf("入站差异分类错误：%v", kinds)
+	}
+	if _, ok := inboundChanges(previous, append(next, inbound("", 6))); ok {
+		t.Fatal("没有 tag 的新入站不能热重载")
+	}
+	if changes, ok := inboundChanges(previous, previous); !ok || len(changes) != 0 {
+		t.Fatal("相同入站不应产生变化")
+	}
+}
