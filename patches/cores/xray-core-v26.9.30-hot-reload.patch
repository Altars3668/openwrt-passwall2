+package core
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	stdnet "net"
+	"sync"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/serial"
+	"github.com/xtls/xray-core/features"
+	"github.com/xtls/xray-core/features/dns"
+	"github.com/xtls/xray-core/features/inbound"
+	"github.com/xtls/xray-core/features/outbound"
+	"github.com/xtls/xray-core/features/routing"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/internet"
+	"google.golang.org/protobuf/proto"
+)
+
+var ErrHotReloadUnsupported = errors.New("hot reload requires core restart")
+
+const maxReloadGenerations = 8
+
+type runtimeGeneration struct {
+	instance   *Instance
+	dispatcher routing.Dispatcher
+	config     *Config
+	cancel     context.CancelFunc
+	active     int
+	retired    bool
+}
+
+type configReloader struct {
+	mu          sync.Mutex
+	applyMu     sync.Mutex
+	closeWait   sync.WaitGroup
+	current     *runtimeGeneration
+	generations []*runtimeGeneration
+	closing     int
+	closed      bool
+}
+
+func newConfigReloader(instance *Instance, dispatcher routing.Dispatcher) *configReloader {
+	initial := &runtimeGeneration{instance: instance, dispatcher: dispatcher}
+	return &configReloader{current: initial, generations: []*runtimeGeneration{initial}}
+}
+
+func staticReloadConfig(config *Config) *Config {
+	result := proto.Clone(config).(*Config)
+	// 入站由初始实例持有，变化的入站在切换时单独关闭重建（见 inboundChanges）。
+	result.Outbound, result.Inbound = nil, nil
+	apps := result.App[:0]
+	for _, app := range result.App {
+		if app.Type != "xray.app.dns.Config" && app.Type != "xray.app.router.Config" {
+			apps = append(apps, app)
+		}
+	}
+	result.App = apps
+	return result
+}
+
+// protobuf 全名以 app/dns/fakedns/fakedns.proto 的 package 为准，测试会对照注册表校验。
+func isFakeDNSApp(app *serial.TypedMessage) bool {
+	return app.Type == "xray.app.dns.fakedns.FakeDnsPoolMulti" || app.Type == "xray.app.dns.fakedns.FakeDnsPool"
+}
+
+// 新运行实例借用初始实例的 FakeDNS 引擎：沿用同一地址池与域名映射，生命周期仍归初始实例。
+// 地址池配置属于静态配置，必须与初始实例一致，因此借用的引擎总能对应新配置。
+type borrowedFakeDNS struct{ dns.FakeDNSEngine }
+
+func (borrowedFakeDNS) Start() error { return nil }
+func (borrowedFakeDNS) Close() error { return nil }
+
+type borrowedFakeDNSRev0 struct{ dns.FakeDNSEngineRev0 }
+
+func (borrowedFakeDNSRev0) Start() error { return nil }
+func (borrowedFakeDNSRev0) Close() error { return nil }
+
+func borrowFakeDNS(owner *Instance) features.Feature {
+	engine, _ := owner.GetFeature((*dns.FakeDNSEngine)(nil)).(dns.FakeDNSEngine)
+	if engine == nil {
+		return nil
+	}
+	if rev0, ok := engine.(dns.FakeDNSEngineRev0); ok {
+		return borrowedFakeDNSRev0{rev0}
+	}
+	return borrowedFakeDNS{engine}
+}
+
+func supportedReloadConfig(config *Config) bool {
+	for _, app := range config.App {
+		if app.Type == "xray.app.metrics.Config" {
+			return false
+		}
+	}
+	for _, outbound := range config.Outbound {
+		if outbound.ProxySettings != nil && (outbound.ProxySettings.Type == "xray.proxy.wireguard.DeviceConfig" || outbound.ProxySettings.Type == "xray.proxy.loopback.Config") {
+			return false
+		}
+	}
+	return true
+}
+
+// 说明需要重启的具体原因，便于运维定位：第一个变化的入站或静态应用、不支持的组件或保留实例上限。
+func reloadUnsupportedReason(previous, next *Config, generations int) string {
+	if !supportedReloadConfig(previous) || !supportedReloadConfig(next) {
+		return "unsupported component (metrics, wireguard or loopback)"
+	}
+	if generations >= maxReloadGenerations {
+		return "too many retained runtime generations"
+	}
+	if _, comparable := inboundChanges(previous.Inbound, next.Inbound); !comparable {
+		return "inbounds without unique tags changed"
+	}
+	oldApps, newApps := staticReloadConfig(previous).App, staticReloadConfig(next).App
+	if len(oldApps) != len(newApps) {
+		return "app set changed"
+	}
+	for i := range oldApps {
+		if !proto.Equal(oldApps[i], newApps[i]) {
+			return "app " + oldApps[i].Type + " changed"
+		}
+	}
+	return "static configuration changed"
+}
+
+type inboundChange struct {
+	tag      string
+	previous *InboundHandlerConfig
+	next     *InboundHandlerConfig
+}
+
+// 按 tag 比较入站：新增、删除与内容变化的入站。没有 tag 或 tag 重复时无法安全对应，返回 false。
+func inboundChanges(previous, next []*InboundHandlerConfig) ([]inboundChange, bool) {
+	old := make(map[string]*InboundHandlerConfig, len(previous))
+	for _, config := range previous {
+		if config.Tag == "" || old[config.Tag] != nil {
+			if len(previous) != len(next) {
+				return nil, false
+			}
+			for i := range previous {
+				if !proto.Equal(previous[i], next[i]) {
+					return nil, false
+				}
+			}
+			return nil, true
+		}
+		old[config.Tag] = config
+	}
+	var changes []inboundChange
+	seen := make(map[string]bool, len(next))
+	for _, config := range next {
+		if config.Tag == "" || seen[config.Tag] {
+			return nil, false
+		}
+		seen[config.Tag] = true
+		if before := old[config.Tag]; before == nil {
+			changes = append(changes, inboundChange{tag: config.Tag, next: config})
+		} else if !proto.Equal(before, config) {
+			changes = append(changes, inboundChange{tag: config.Tag, previous: before, next: config})
+		}
+	}
+	for _, config := range previous {
+		if !seen[config.Tag] {
+			changes = append(changes, inboundChange{tag: config.Tag, previous: config})
+		}
+	}
+	return changes, true
+}
+
+// 在初始实例的入站管理器上应用入站变化：先关闭旧入站（同端口才能重新绑定），再创建并启动新入站。
+// 新入站与原有入站一样经初始实例的分发器交给当前运行实例。任一步失败按相反顺序恢复原入站。
+func (s *Instance) applyInbounds(ctx context.Context, changes []inboundChange) (func(), error) {
+	manager, _ := s.GetFeature(inbound.ManagerType()).(inbound.Manager)
+	if manager == nil {
+		return nil, ErrHotReloadUnsupported
+	}
+	add := func(config *InboundHandlerConfig) error {
+		raw, err := CreateObject(s, config)
+		if err != nil {
+			return err
+		}
+		handler, ok := raw.(inbound.Handler)
+		if !ok {
+			return errors.New("not an inbound handler")
+		}
+		if err := manager.AddHandler(ctx, handler); err != nil {
+			// 管理器先登记再启动：启动失败时登记仍在，必须移除（同时关闭已启动的部分）。
+			if current, _ := manager.GetHandler(ctx, config.Tag); current == handler {
+				manager.RemoveHandler(ctx, config.Tag)
+			} else {
+				handler.Close()
+			}
+			return err
+		}
+		return nil
+	}
+	var undo []func()
+	rollback := func() {
+		for i := len(undo) - 1; i >= 0; i-- {
+			undo[i]()
+		}
+	}
+	// 先关闭全部要删除或替换的旧入站，再创建新入站：换 tag 但沿用端口（如重定向改为 TPROXY）时才能绑定。
+	for _, change := range changes {
+		change := change
+		if change.previous != nil {
+			if err := manager.RemoveHandler(ctx, change.tag); err != nil && !errors.Is(err, common.ErrNoClue) {
+				rollback()
+				return nil, fmt.Errorf("close inbound %s: %w", change.tag, err)
+			}
+			undo = append(undo, func() { _ = add(change.previous) })
+		}
+	}
+	for _, change := range changes {
+		change := change
+		if change.next != nil {
+			if err := add(change.next); err != nil {
+				rollback()
+				return nil, fmt.Errorf("create inbound %s: %w", change.tag, err)
+			}
+			undo = append(undo, func() { _ = manager.RemoveHandler(ctx, change.tag) })
+		}
+	}
+	return rollback, nil
+}
+
+func (r *configReloader) collectLocked(generation *runtimeGeneration) {
+	if !generation.retired || generation.active != 0 || generation.cancel == nil {
+		return
+	}
+	for i, candidate := range r.generations {
+		if candidate == generation {
+			r.generations = append(r.generations[:i], r.generations[i+1:]...)
+			break
+		}
+	}
+	cancel := generation.cancel
+	generation.cancel = nil
+	r.closeWait.Add(1)
+	r.closing++
+	go func() {
+		defer r.closeWait.Done()
+		cancel()
+		generation.instance.Close()
+		r.mu.Lock()
+		r.closing--
+		r.mu.Unlock()
+	}()
+}
+
+func (r *configReloader) acquire() (*runtimeGeneration, func()) {
+	r.mu.Lock()
+	if r.closed {
+		r.mu.Unlock()
+		return nil, func() {}
+	}
+	generation := r.current
+	generation.active++
+	r.mu.Unlock()
+	var once sync.Once
+	return generation, func() {
+		once.Do(func() {
+			r.mu.Lock()
+			generation.active--
+			r.collectLocked(generation)
+			r.mu.Unlock()
+		})
+	}
+}
+
+func (s *Instance) dialerContext(ctx context.Context) context.Context {
+	client, _ := s.GetFeature(dns.ClientType()).(dns.Client)
+	manager, _ := s.GetFeature(outbound.ManagerType()).(outbound.Manager)
+	return internet.ContextWithDialerState(ctx, client, manager)
+}
+
+func (s *Instance) AcquireActiveRuntime() (*Instance, func()) {
+	if s.reloader == nil {
+		return s, func() {}
+	}
+	generation, release := s.reloader.acquire()
+	if generation == nil {
+		return nil, release
+	}
+	return generation.instance, release
+}
+
+func (s *Instance) ReloadConfig(requestCtx context.Context, config *Config) error {
+	if s.reloader == nil || !s.started.Load() {
+		return ErrHotReloadUnsupported
+	}
+	r := s.reloader
+	r.applyMu.Lock()
+	defer r.applyMu.Unlock()
+	r.mu.Lock()
+	if r.closed {
+		r.mu.Unlock()
+		return stdnet.ErrClosed
+	}
+	previous := r.current
+	if proto.Equal(previous.config, config) {
+		r.mu.Unlock()
+		return nil
+	}
+	changes, comparable := inboundChanges(previous.config.Inbound, config.Inbound)
+	if !comparable || !supportedReloadConfig(previous.config) || !supportedReloadConfig(config) ||
+		!proto.Equal(staticReloadConfig(previous.config), staticReloadConfig(config)) ||
+		len(r.generations)+r.closing >= maxReloadGenerations {
+		reason := reloadUnsupportedReason(previous.config, config, len(r.generations)+r.closing)
+		r.mu.Unlock()
+		return fmt.Errorf("%w: %s", ErrHotReloadUnsupported, reason)
+	}
+	r.mu.Unlock()
+	if err := requestCtx.Err(); err != nil {
+		return err
+	}
+	staged := proto.Clone(config).(*Config)
+	staged.Inbound = nil
+	var apps []*serial.TypedMessage
+	fakeDNS := false
+	for _, app := range staged.App {
+		// 预加载不能注册全局日志，也不能重复绑定控制端口；FakeDNS 改为借用初始实例的引擎。
+		if isFakeDNSApp(app) {
+			fakeDNS = true
+		} else if app.Type != "xray.app.log.Config" && app.Type != "xray.app.commander.Config" {
+			apps = append(apps, app)
+		}
+	}
+	staged.App = apps
+	ctx, cancel := context.WithCancel(s.ctx)
+	stopCancellation := context.AfterFunc(requestCtx, cancel)
+	defer stopCancellation()
+	instance := &Instance{ctx: ctx, reloadStaging: true}
+	if fakeDNS {
+		borrowed := borrowFakeDNS(s)
+		if borrowed == nil {
+			cancel()
+			return ErrHotReloadUnsupported
+		}
+		if err := instance.AddFeature(borrowed); err != nil {
+			cancel()
+			return err
+		}
+	}
+	_, err := initInstanceWithConfig(staged, instance)
+	if err != nil {
+		cancel()
+		instance.Close()
+		return err
+	}
+	manager := instance.GetFeature(outbound.ManagerType()).(outbound.Manager)
+	if manager.GetDefaultHandler() == nil {
+		cancel()
+		instance.Close()
+		return errors.New("no outbound available")
+	}
+	for _, rule := range instance.GetFeature(routing.RouterType()).(routing.Router).ListRule() {
+		if tag := rule.GetOutboundTag(); tag != "" && manager.GetHandler(tag) == nil {
+			cancel()
+			instance.Close()
+			return errors.New("routing references an unavailable outbound")
+		}
+	}
+	if err = instance.Start(); err != nil {
+		cancel()
+		instance.Close()
+		return err
+	}
+	if !stopCancellation() || requestCtx.Err() != nil || ctx.Err() != nil {
+		cancel()
+		instance.Close()
+		return errors.New("hot reload request canceled before commit")
+	}
+	// 入站变化在新运行实例就绪之后、切换之前应用。
+	var undoInbounds func()
+	if len(changes) > 0 {
+		if undoInbounds, err = s.applyInbounds(s.ctx, changes); err != nil {
+			cancel()
+			instance.Close()
+			return fmt.Errorf("apply hot reload inbounds: %w", err)
+		}
+	}
+	r.mu.Lock()
+	if r.closed {
+		r.mu.Unlock()
+		if undoInbounds != nil {
+			undoInbounds()
+		}
+		cancel()
+		instance.Close()
+		return stdnet.ErrClosed
+	}
+	generation := &runtimeGeneration{instance: instance, dispatcher: instance.GetFeature(routing.DispatcherType()).(routing.Dispatcher), config: proto.Clone(config).(*Config), cancel: cancel}
+	r.generations = append(r.generations, generation)
+	r.current = generation
+	previous.retired = true
+	r.collectLocked(previous)
+	r.mu.Unlock()
+	return nil
+}
+
+func (r *configReloader) close() {
+	r.applyMu.Lock()
+	defer r.applyMu.Unlock()
+	r.mu.Lock()
+	r.closed = true
+	var targets []struct {
+		cancel   context.CancelFunc
+		instance *Instance
+	}
+	for _, generation := range r.generations {
+		if generation.cancel != nil {
+			targets = append(targets, struct {
+				cancel   context.CancelFunc
+				instance *Instance
+			}{generation.cancel, generation.instance})
+			generation.cancel = nil
+		}
+	}
+	r.generations = nil
+	r.mu.Unlock()
+	for _, target := range targets {
+		target.cancel()
+		target.instance.Close()
+	}
+	r.closeWait.Wait()
+}
+
+type runtimeDispatcher struct {
+	routing.Dispatcher
+	reload *configReloader
+}
+
+// 半关闭只释放对应方向；两个方向结束或请求取消后才能回收旧实例。
+type linkLease struct {
+	mu       sync.Mutex
+	finished int
+	released bool
+	release  func()
+	stop     func() bool
+}
+
+func newLinkLease(ctx context.Context, release func()) *linkLease {
+	lease := &linkLease{release: release}
+	stop := context.AfterFunc(ctx, func() { lease.finish(true) })
+	lease.mu.Lock()
+	if lease.released {
+		lease.mu.Unlock()
+		stop()
+	} else {
+		lease.stop = stop
+		lease.mu.Unlock()
+	}
+	return lease
+}
+
+func (l *linkLease) finish(all bool) {
+	l.mu.Lock()
+	if l.released {
+		l.mu.Unlock()
+		return
+	}
+	l.finished++
+	if !all && l.finished < 2 {
+		l.mu.Unlock()
+		return
+	}
+	l.released = true
+	stop := l.stop
+	l.mu.Unlock()
+	if stop != nil {
+		stop()
+	}
+	l.release()
+}
+
+type leasedReader struct {
+	buf.Reader
+	once  sync.Once
+	lease *linkLease
+}
+
+func (r *leasedReader) finish() { r.once.Do(func() { r.lease.finish(false) }) }
+func (r *leasedReader) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	mb, err := r.Reader.ReadMultiBuffer()
+	if err != nil {
+		r.finish()
+	}
+	return mb, err
+}
+func (r *leasedReader) Interrupt() {
+	common.Interrupt(r.Reader)
+	r.finish()
+}
+func (r *leasedReader) Close() error {
+	common.Interrupt(r.Reader)
+	r.finish()
+	return nil
+}
+
+type leasedWriter struct {
+	buf.Writer
+	once  sync.Once
+	lease *linkLease
+}
+
+func (w *leasedWriter) finish() { w.once.Do(func() { w.lease.finish(false) }) }
+func (w *leasedWriter) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	err := w.Writer.WriteMultiBuffer(mb)
+	if err != nil {
+		w.finish()
+	}
+	return err
+}
+func (w *leasedWriter) Interrupt() {
+	common.Interrupt(w.Writer)
+	w.finish()
+}
+func (w *leasedWriter) Close() error {
+	var err error
+	if closer, ok := w.Writer.(io.Closer); ok {
+		err = closer.Close()
+	} else {
+		common.Interrupt(w.Writer)
+	}
+	w.finish()
+	return err
+}
+
+func leaseLink(link *transport.Link, lease *linkLease) {
+	link.Reader = &leasedReader{Reader: link.Reader, lease: lease}
+	link.Writer = &leasedWriter{Writer: link.Writer, lease: lease}
+}
+
+func (d *runtimeDispatcher) Dispatch(ctx context.Context, destination net.Destination) (*transport.Link, error) {
+	generation, release := d.reload.acquire()
+	if generation == nil {
+		return nil, stdnet.ErrClosed
+	}
+	ctx = generation.instance.dialerContext(ctx)
+	lease := newLinkLease(ctx, release)
+	link, err := generation.dispatcher.Dispatch(ctx, destination)
+	if err != nil {
+		lease.finish(true)
+		return nil, err
+	}
+	leaseLink(link, lease)
+	return link, nil
+}
+
+func (d *runtimeDispatcher) DispatchLink(ctx context.Context, destination net.Destination, link *transport.Link) error {
+	generation, release := d.reload.acquire()
+	if generation == nil {
+		return stdnet.ErrClosed
+	}
+	ctx = generation.instance.dialerContext(ctx)
+	lease := newLinkLease(ctx, release)
+	leased := *link
+	leaseLink(&leased, lease)
+	err := generation.dispatcher.DispatchLink(ctx, destination, &leased)
+	if err != nil {
+		lease.finish(true)
+	}
+	return err
+}
