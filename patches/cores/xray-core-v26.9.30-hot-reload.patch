+)
+
+// 类型名写错时判断会静默失效：FakeDNS 不再借用初始实例的地址池，metrics 也不再被拒绝。
+func TestHotReloadAppTypeNames(t *testing.T) {
+	for _, message := range []*serial.TypedMessage{
+		serial.ToTypedMessage(&fakedns.FakeDnsPoolMulti{}),
+		serial.ToTypedMessage(&fakedns.FakeDnsPool{}),
+	} {
+		if !IsFakeDNSAppForTest(message) {
+			t.Fatalf("未识别 FakeDNS 应用类型 %s", message.Type)
+		}
+	}
+	if IsFakeDNSAppForTest(serial.ToTypedMessage(&log.Config{})) {
+		t.Fatal("把日志应用误判为 FakeDNS")
+	}
+	if SupportedReloadConfigForTest(&Config{App: []*serial.TypedMessage{serial.ToTypedMessage(&metrics.Config{})}}) {
+		t.Fatal("metrics 应用必须要求核心重启")
+	}
+}
