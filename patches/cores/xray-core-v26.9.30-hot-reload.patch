diff --git a/main/commands/all/api/config_reload.go b/main/commands/all/api/config_reload.go
new file mode 100644
index 0000000..d0d814a
--- /dev/null
+++ b/main/commands/all/api/config_reload.go
@@ -0,0 +1,79 @@
+package api
+
+import (
+	"fmt"
+	"io"
+	"os"
+
+	"github.com/xtls/xray-core/app/proxyman/command"
+	"github.com/xtls/xray-core/main/commands/base"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/types/known/wrapperspb"
+)
+
+var cmdReloadConfig = &base.Command{
+	CustomFlags: true,
+	UsageLine:   "{{.Exec}} api reloadconfig [--server=127.0.0.1:8080] [--check] [--geodata] [<config.json>]",
+	Short:       "Hot reload outbound, routing and DNS configuration",
+	Long:        "新配置先预加载，再切换新连接；已有连接继续使用旧实例。--check 只查询能力。--geodata 先重新读取 geoip/geosite 数据文件并原地重建匹配器，可不带配置单独使用。需要完整核心重启时退出码为 2，其他失败为 1。",
+	Run:         executeReloadConfig,
+}
+
+func executeReloadConfig(cmd *base.Command, args []string) {
+	setSharedFlags(cmd)
+	check := cmd.Flag.Bool("check", false, "")
+	local := cmd.Flag.Bool("local", false, "")
+	geodata := cmd.Flag.Bool("geodata", false, "")
+	cmd.Flag.Parse(args)
+	if *local {
+		fmt.Println(`{"hot_reload_version":1,"geodata":true}`)
+		return
+	}
+	var content []byte
+	files := cmd.Flag.Args()
+	geodataOnly := *geodata && !*check && len(files) == 0
+	if !*check && !geodataOnly {
+		if len(files) != 1 {
+			base.Fatalf("one configuration file required")
+		}
+		reader, err := loadArg(files[0])
+		if err != nil {
+			base.Fatalf("unable to read configuration")
+		}
+		if closer, ok := reader.(io.Closer); ok {
+			defer closer.Close()
+		}
+		content, err = io.ReadAll(io.LimitReader(reader, (4<<20)+1))
+		if err != nil || len(content) == 0 || len(content) > 4<<20 {
+			base.Fatalf("invalid configuration size")
+		}
+	}
+	conn, ctx, close := dialAPIServer()
+	defer close()
+	invoke := func(method string, request []byte, action string) {
+		response := new(wrapperspb.Int32Value)
+		err := conn.Invoke(ctx, method, wrapperspb.Bytes(request), response)
+		if err != nil {
+			if status.Code(err) == codes.FailedPrecondition || status.Code(err) == codes.Unimplemented {
+				// 第一行保持 requires_restart 便于脚本判断，第二行给出核心报告的原因。
+				fmt.Fprintln(os.Stderr, "requires_restart")
+				fmt.Fprintln(os.Stderr, status.Convert(err).Message())
+				os.Exit(2)
+			}
+			base.Fatalf("%s not applied: %s: %s", action, status.Code(err), status.Convert(err).Message())
+		}
+		if response.Value != 1 {
+			base.Fatalf("unsupported hot reload protocol")
+		}
+	}
+	if *geodata && !*check {
+		invoke(command.ConfigReloadGeodataMethod, nil, "geodata")
+		if geodataOnly {
+			fmt.Println(`{"hot_reload_version":1,"geodata":true,"applied":true}`)
+			return
+		}
+	}
+	invoke(command.ConfigReloadMethod, content, "configuration")
+	fmt.Println(`{"hot_reload_version":1,"applied":` + fmt.Sprint(!*check) + `}`)
+}
