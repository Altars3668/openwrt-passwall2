diff --git a/app/proxyman/command/config_reload.go b/app/proxyman/command/config_reload.go
new file mode 100644
index 0000000..7e91717
--- /dev/null
+++ b/app/proxyman/command/config_reload.go
@@ -0,0 +1,132 @@
+package command
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"net"
+	"os"
+	"strings"
+
+	"github.com/xtls/xray-core/common/geodata"
+	"github.com/xtls/xray-core/core"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/peer"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/types/known/wrapperspb"
+)
+
+const (
+	ConfigReloadMethod        = "/xray.app.proxyman.command.ConfigReloadService/Reload"
+	ConfigReloadGeodataMethod = "/xray.app.proxyman.command.ConfigReloadService/ReloadGeodata"
+)
+
+type configReloadServer interface {
+	Reload(context.Context, *wrapperspb.BytesValue) (*wrapperspb.Int32Value, error)
+	ReloadGeodata(context.Context, *wrapperspb.BytesValue) (*wrapperspb.Int32Value, error)
+}
+
+type configReloadService struct{ instance *core.Instance }
+
+func requireLoopback(ctx context.Context) error {
+	remote, ok := peer.FromContext(ctx)
+	if !ok {
+		return status.Error(codes.PermissionDenied, "loopback API required")
+	}
+	address, ok := remote.Addr.(*net.TCPAddr)
+	if !ok || !address.IP.IsLoopback() {
+		return status.Error(codes.PermissionDenied, "loopback API required")
+	}
+	return nil
+}
+
+// ReloadGeodata 重新读取 geoip/geosite 数据文件，并原地重建所有已登记的匹配器（包括仍在排空的旧运行实例）。
+// 匹配器按“文件:代码”缓存，只重载配置会沿用旧数据；每个登记表先全部构建成功才替换，失败时保持原数据。
+func (s *configReloadService) ReloadGeodata(ctx context.Context, _ *wrapperspb.BytesValue) (*wrapperspb.Int32Value, error) {
+	if err := requireLoopback(ctx); err != nil {
+		return nil, err
+	}
+	if err := errors.Join(geodata.IPReg.Reload(), geodata.DomainReg.Reload()); err != nil {
+		return nil, status.Error(codes.InvalidArgument, err.Error())
+	}
+	return wrapperspb.Int32(1), nil
+}
+
+func (s *configReloadService) Reload(ctx context.Context, request *wrapperspb.BytesValue) (*wrapperspb.Int32Value, error) {
+	if err := requireLoopback(ctx); err != nil {
+		return nil, err
+	}
+	if len(request.Value) == 0 {
+		return wrapperspb.Int32(1), nil
+	}
+	if len(request.Value) > 4<<20 {
+		return nil, status.Error(codes.ResourceExhausted, "configuration too large")
+	}
+	var fields map[string]json.RawMessage
+	if err := json.Unmarshal(request.Value, &fields); err != nil {
+		return nil, status.Error(codes.InvalidArgument, "invalid configuration")
+	}
+	// Build 会把 env 写入进程环境：只接受与当前进程环境完全一致的 env（写入等于无操作），
+	// 真正的环境变化必须在调用配置加载器之前拒绝。
+	for key, raw := range fields {
+		if !strings.EqualFold(key, "env") {
+			continue
+		}
+		var env map[string]string
+		if err := json.Unmarshal(raw, &env); err != nil {
+			return nil, status.Error(codes.InvalidArgument, "invalid env configuration")
+		}
+		for name, value := range env {
+			if current, ok := os.LookupEnv(name); !ok || current != value {
+				return nil, status.Error(codes.FailedPrecondition, core.ErrHotReloadUnsupported.Error()+": env "+name+" changed")
+			}
+		}
+	}
+	config, err := core.LoadConfig("json", bytes.NewReader(request.Value))
+	if err != nil {
+		return nil, status.Error(codes.InvalidArgument, "invalid configuration")
+	}
+	if err = s.instance.ReloadConfig(ctx, config); err != nil {
+		code := codes.InvalidArgument
+		if errors.Is(err, core.ErrHotReloadUnsupported) {
+			code = codes.FailedPrecondition
+		} else if ctx.Err() != nil {
+			return nil, status.FromContextError(ctx.Err()).Err()
+		}
+		// 只经本机回环接口返回给调用者，保留原因便于定位。
+		return nil, status.Error(code, err.Error())
+	}
+	return wrapperspb.Int32(1), nil
+}
+
+func reloadMethod(name, fullMethod string, call func(configReloadServer, context.Context, *wrapperspb.BytesValue) (*wrapperspb.Int32Value, error)) grpc.MethodDesc {
+	return grpc.MethodDesc{
+		MethodName: name,
+		Handler: func(srv interface{}, ctx context.Context, decode func(interface{}) error, interceptor grpc.UnaryServerInterceptor) (interface{}, error) {
+			request := new(wrapperspb.BytesValue)
+			if err := decode(request); err != nil {
+				return nil, err
+			}
+			if interceptor == nil {
+				return call(srv.(configReloadServer), ctx, request)
+			}
+			info := &grpc.UnaryServerInfo{Server: srv, FullMethod: fullMethod}
+			return interceptor(ctx, request, info, func(ctx context.Context, request interface{}) (interface{}, error) {
+				return call(srv.(configReloadServer), ctx, request.(*wrapperspb.BytesValue))
+			})
+		},
+	}
+}
+
+func registerConfigReload(server *grpc.Server, instance *core.Instance) {
+	server.RegisterService(&grpc.ServiceDesc{
+		ServiceName: "xray.app.proxyman.command.ConfigReloadService",
+		HandlerType: (*configReloadServer)(nil),
+		Methods: []grpc.MethodDesc{
+			reloadMethod("Reload", ConfigReloadMethod, configReloadServer.Reload),
+			reloadMethod("ReloadGeodata", ConfigReloadGeodataMethod, configReloadServer.ReloadGeodata),
+		},
+	}, &configReloadService{instance: instance})
+}
