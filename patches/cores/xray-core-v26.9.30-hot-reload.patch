+	"testing"
+
+	"github.com/xtls/xray-core/common/geodata"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/peer"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/proto"
+)
+
+func writeTestGeoSite(t *testing.T, dir, domain string) {
+	t.Helper()
+	list := &geodata.GeoSiteList{Entry: []*geodata.GeoSite{{
+		Code:   "PW2TEST",
+		Domain: []*geodata.Domain{{Type: geodata.Domain_Full, Value: domain}},
+	}}}
+	content, err := proto.Marshal(list)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tmp := filepath.Join(dir, "pw2test.dat.tmp")
+	if err := os.WriteFile(tmp, content, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Rename(tmp, filepath.Join(dir, "pw2test.dat")); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func loopbackContext(ip net.IP) context.Context {
+	return peer.NewContext(context.Background(), &peer.Peer{Addr: &net.TCPAddr{IP: ip, Port: 1}})
+}
+
+func TestReloadGeodataRebuildsRegisteredMatchers(t *testing.T) {
+	dir := t.TempDir()
+	t.Setenv("xray.location.asset", dir)
+	writeTestGeoSite(t, dir, "old.example")
+	rules := []*geodata.DomainRule{{Value: &geodata.DomainRule_Geosite{
+		Geosite: &geodata.GeoSiteRule{File: "pw2test.dat", Code: "PW2TEST"},
+	}}}
+	matcher, err := geodata.DomainReg.BuildDomainMatcher(rules)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !matcher.MatchAny("old.example") || matcher.MatchAny("new.example") {
+		t.Fatal("unexpected initial geosite data")
+	}
+
+	writeTestGeoSite(t, dir, "new.example")
+	// 匹配器按“文件:代码”缓存：不调用 ReloadGeodata 时，重新构建（如重载配置）仍得到旧数据。
+	cached, err := geodata.DomainReg.BuildDomainMatcher(rules)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cached.MatchAny("new.example") {
+		t.Fatal("matcher cache unexpectedly picked up the new file")
+	}
+
+	service := &configReloadService{}
+	if _, err := service.ReloadGeodata(loopbackContext(net.IPv4(192, 0, 2, 1)), nil); status.Code(err) != codes.PermissionDenied {
+		t.Fatalf("non-loopback caller: %v", err)
+	}
+	if _, err := service.ReloadGeodata(loopbackContext(net.IPv4(127, 0, 0, 1)), nil); err != nil {
+		t.Fatal(err)
+	}
+	for name, m := range map[string]geodata.DomainMatcher{"registered": matcher, "cached": cached} {
+		if !m.MatchAny("new.example") || m.MatchAny("old.example") {
+			t.Fatalf("%s matcher was not rebuilt in place", name)
+		}
+	}
+	fresh, err := geodata.DomainReg.BuildDomainMatcher(rules)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !fresh.MatchAny("new.example") {
+		t.Fatal("matchers built after reload must use the new data")
+	}
+
+	if err := os.WriteFile(filepath.Join(dir, "pw2test.dat"), []byte{0x0a, 0xff, 0xff}, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := service.ReloadGeodata(loopbackContext(net.IPv6loopback), nil); status.Code(err) != codes.InvalidArgument {
+		t.Fatalf("broken geosite file: %v", err)
+	}
+	if !matcher.MatchAny("new.example") {
+		t.Fatal("a failed reload must keep the previous data")
+	}
+}
