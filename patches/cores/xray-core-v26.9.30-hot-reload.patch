+package internet
+
+import (
+	"context"
+
+	"github.com/xtls/xray-core/features/dns"
+	"github.com/xtls/xray-core/features/outbound"
+)
+
+type dialerStateKey struct{}
+type dialerState struct {
+	dns      dns.Client
+	outbound outbound.Manager
+}
+
+// ContextWithDialerState 将拨号依赖绑定到请求所属实例，避免预加载修改全局 DNS。
+func ContextWithDialerState(ctx context.Context, dc dns.Client, om outbound.Manager) context.Context {
+	return context.WithValue(ctx, dialerStateKey{}, dialerState{dns: dc, outbound: om})
+}
+
+func stateForDialer(ctx context.Context) dialerState {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if state, ok := ctx.Value(dialerStateKey{}).(dialerState); ok {
+		return state
+	}
+	return dialerState{dns: dnsClient, outbound: obm}
+}
